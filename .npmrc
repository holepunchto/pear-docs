# @tetherto/* packages are published to GitHub Packages.
# Token is read from $GITHUB_TOKEN at install time (see .env.example).
# Same setup used across the org (e.g. qvac's run-lint-and-unit-tests action).
@tetherto:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
