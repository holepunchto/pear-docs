# @tetherto/* packages live in the `src/lib/docs-template` git submodule and
# are linked into node_modules/@tetherto/* via npm `workspaces`. The lockfile
# pins each entry as a workspace link, so this registry block is dormant for
# ordinary installs.
#
# It still gets used for maintainer flows that bypass the submodule
# (e.g. publishing a new release, or installing without the submodule on
# hand). Token is read from $GITHUB_TOKEN at install time (see .env.example).
@tetherto:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
