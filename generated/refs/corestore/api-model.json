    {
      "name": "CorestoreOptions",
      "description": "Options for the {@link Corestore} constructor. Any other options are forwarded\nto the underlying `hypercore-storage` instance.",
      "properties": [
        {
          "name": "primaryKey",
          "optional": true,
          "type": "Buffer",
          "description": "The 32-byte master key from which all writable named cores are derived. Generated and persisted automatically when omitted."
        },
        {
          "name": "writable",
          "optional": true,
          "default": "true",
          "type": "boolean",
          "description": "Set to `false` to open the store read-only; loaded cores default to read-only too."
        },
        {
          "name": "readOnly",
          "optional": true,
          "default": "false",
          "type": "boolean",
          "description": "Open the backing storage in read-only mode."
        },
        {
          "name": "active",
          "optional": true,
          "default": "true",
          "type": "boolean",
          "description": "Whether loaded cores are automatically attached to active replication streams."
        },
        {
          "name": "unsafe",
          "optional": true,
          "default": "false",
          "type": "boolean",
          "description": "Acknowledge that passing `primaryKey` directly is unsafe; required when `primaryKey` is set on a root store."
        }
