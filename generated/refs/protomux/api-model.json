    {
      "name": "ProtomuxOptions",
      "description": "Options for allocating buffers in a Protomux instance.",
      "properties": [
        {
          "name": "alloc",
          "optional": true,
          "type": "Function",
          "description": "Custom allocator; called with `(size)` and must return a `Buffer`. Defaults to `Buffer.allocUnsafe`."
        }
      ]
    },
    {
      "name": "CreateChannelOptions",
      "description": "Options for creating a protocol channel.",
      "properties": [
        {
          "name": "protocol",
          "optional": false,
          "type": "string",
          "description": "Protocol name used to match channels between peers."
        },
        {
          "name": "id",
          "optional": true,
          "default": "null",
          "type": "Buffer|null",
          "description": "Optional binary identifier to distinguish multiple channels with the same protocol name."
        },
        {
          "name": "handshake",
          "optional": true,
          "default": "null",
          "type": "*",
          "description": "Compact-encoding codec for encoding/decoding the handshake value exchanged on open."
        },
        {
          "name": "messages",
          "optional": true,
          "default": "[]",
          "type": "Array<AddMessageOptions>",
          "description": "Array of message descriptors registered on channel open."
        },
        {
          "name": "unique",
          "optional": true,
          "default": "true",
          "type": "boolean",
          "description": "When `true`, returns `null` if a channel with this protocol+id is already open."
        },
        {
          "name": "aliases",
          "optional": true,
          "default": "[]",
          "type": "Array<string>",
          "description": "Alternative protocol names that also match this channel."
        },
        {
          "name": "userData",
          "optional": true,
          "default": "null",
          "type": "*",
          "description": "Arbitrary value stored as `channel.userData`; not transmitted."
        },
        {
          "name": "onopen",
          "optional": true,
          "type": "Function",
          "description": "Called with `(handshake, channel)` when the remote side opens this protocol."
        },
        {
          "name": "onclose",
          "optional": true,
          "type": "Function",
          "description": "Called with `(isRemote, channel)` when either side closes the channel."
        },
        {
          "name": "ondestroy",
          "optional": true,
          "type": "Function",
          "description": "Called with `(channel)` after `onclose` resolves and all pending promises settle."
        },
        {
          "name": "ondrain",
          "optional": true,
          "type": "Function",
          "description": "Called with `(channel)` when the underlying stream drains."
        }
      ]
    },
    {
      "name": "AddMessageOptions",
      "description": "Options for registering a message type on a channel.",
      "properties": [
        {
          "name": "encoding",
          "optional": true,
          "type": "object",
          "description": "A compact-encoding codec. Defaults to raw binary (`c.raw`)."
        },
        {
          "name": "autoBatch",
          "optional": true,
          "default": "true",
          "type": "boolean",
          "description": "When `true`, batch replies are collected before the next tick."
        },
        {
          "name": "onmessage",
          "optional": true,
          "type": "Function",
          "description": "Called with `(message, channel)` when the remote sends a message of this type."
        }
      ]
    },
    {
      "name": "ChannelKey",
      "description": "Protocol + id selector used by pair/unpair/opened/getLastChannel.",
      "properties": [
        {
          "name": "protocol",
          "optional": false,
          "type": "string",
          "description": "Protocol name to match."
        },
        {
          "name": "id",
          "optional": true,
          "default": "null",
          "type": "Buffer|null",
          "description": "Optional binary id to narrow the match."
        }
      ]
    }
