      "kind": "function",
      "static": false,
      "signatures": [
        "createServer(opts?: TLSSocketOptions, onconnection?: (socket: TLSSocket) => void): TLSNetServer"
      ],
      "description": "Creates a TLS server that listens for TCP connections and wraps them with TLS. Incoming\nconnections are emitted as `'connection'` events with a `tls.Socket` instance. Options are the\nsame as `tls.Socket`, plus any options supported by <https://github.com/holepunchto/bare-net>.",
