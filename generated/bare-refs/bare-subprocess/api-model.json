      "params": [
        {
          "name": "file",
          "type": "string",
          "optional": false,
          "default": null,
          "description": "The executable to spawn; a string path or a `file://` URL."
        },
        {
          "name": "args",
          "type": "string[] | null",
          "optional": true,
          "default": null,
          "description": "Arguments to pass to `file`; may be `null` or omitted to spawn with none. If omitted, the second argument is treated as `opts`."
        },
        {
          "name": "opts",
          "type": "SpawnOptions",
          "optional": true,
          "default": null,
          "description": "Options controlling the environment, stdio, and behavior of the new subprocess; see `SpawnOptions`."
