  "usage": "```js\nconst structuredClone = require('bare-structured-clone')\n\nconst copy = structuredClone({ hello: 'world' })\n\nconst buffer = new ArrayBuffer(4)\nconst transferred = structuredClone(buffer, { transfer: [buffer] })\n```\n\nTo install `structuredClone` as a global, require the `global` submodule:\n\n```js\nrequire('bare-structured-clone/global')\n\nconst copy = structuredClone({ hello: 'world' })\n```",
  "exports": [
    {
      "key": "structuredClone",
      "name": "structuredClone",
      "kind": "function",
      "static": false,
      "signatures": [
        "structuredClone<T extends SerializableValue | TransferableValue>(value: T, opts?: StructuredCloneOptions): T"
      ],
      "description": "Clone `value` by serializing and then deserializing it. `opts` may include a `transfer` list and an `interfaces` list.",
      "deprecated": null,
      "params": [
        {
          "name": "value",
          "type": "T",
          "optional": false,
          "default": null,
          "description": "- The value to clone."
        },
        {
          "name": "opts",
          "type": "StructuredCloneOptions",
          "optional": true,
          "default": null,
          "description": "- Options carrying the optional `transfer` and `interfaces` lists."
        }
      ],
      "returns": {
        "type": "T",
        "description": "A deep copy of `value`, with any transferred objects detached from the original."
      },
      "throws": [
        {
          "type": "UNSERIALIZABLE_TYPE",
          "condition": "`value`, or a value it references, is of a type that cannot be serialized (for example a function, a symbol, or a detached `ArrayBuffer`)."
        },
        {
          "type": "UNTRANSFERABLE_TYPE",
          "condition": "a value in the `transfer` list cannot be transferred."
        },
        {
          "type": "ALREADY_TRANSFERRED",
          "condition": "a value in the `transfer` list has already been transferred."
        },
        {
          "type": "INVALID_INTERFACE",
          "condition": "a serializable or transferable value has an interface that is not present in the `interfaces` list."
        }
      ],
      "members": []
    },
