    "bare-stream"
  ],
  "usage": "```js\nimport RPC from 'bare-rpc'\n\n// On one end\nconst rpc = new RPC(stream, (req) => {\n  if (req.command === 42) {\n    console.log(req.data.toString()) // ping\n    req.reply('pong')\n  }\n})\n\n// On the other end\nconst req = rpc.request(42)\nreq.send('ping')\n\nconst replyBuffer = await req.reply()\nconsole.log(replyBuffer.toString()) // pong\n```",
