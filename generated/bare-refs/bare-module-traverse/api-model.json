{
  "name": "bare-module-traverse",
  "version": "2.4.4",
  "description": "Low-level module graph traversal for Bare",
  "repoUrl": "https://github.com/holepunchto/bare-module-traverse",
  "npmUrl": "https://www.npmjs.com/package/bare-module-traverse",
  "minBare": null,
  "native": false,
  "dependencies": [
    "bare-addon-resolve",
    "bare-mime",
    "bare-module-lexer",
    "bare-module-resolve"
  ],
  "usage": "For synchronous traversal:\n\n```js\nconst traverse = require('bare-module-traverse')\n\nfunction readModule(url) {\n  // Read `url` if it exists, otherwise `null`\n}\n\nfunction* listPrefix(url) {\n  // Yield URLs that have `url` as a prefix. The list may be empty.\n}\n\nfor (const dependency of traverse(new URL('file:///directory/file.js'), readModule, listPrefix)) {\n  console.log(dependency)\n}\n```\n\nFor asynchronous traversal:\n\n```js\nconst traverse = require('bare-module-traverse')\n\nasync function readModule(url) {\n  // Read `url` if it exists, otherwise `null`\n}\n\nasync function* listPrefix(url) {\n  // Yield URLs that have `url` as a prefix. The list may be empty.\n}\n\nfor await (const dependency of traverse(\n  new URL('file:///directory/file.js'),\n  readModule,\n  listPrefix\n)) {\n  console.log(dependency)\n}\n```",
  "extraSections": [],
  "exports": [
    {
      "key": "traverse",
      "name": "traverse",
      "kind": "function",
      "static": false,
      "signatures": [
        "traverse(entry: URL, readModule: (url: URL) => Buffer | string | null, listPrefix?: (url: URL) => Iterable<URL>, probeModule?: (url: URL) => boolean | undefined, resolveModule?: (url: URL) => URL): Iterable<Dependency>",
        "traverse(entry: URL, readModule: (url: URL) => Promise<Buffer | string | null>, listPrefix?: (url: URL) => AsyncIterable<URL>, probeModule?: (url: URL) => Promise<boolean | undefined>, resolveModule?: (url: URL) => Promise<URL>): AsyncIterable<Dependency>",
        "traverse(entry: URL, opts: TraverseOptions, readModule: (url: URL) => Buffer | string | null, listPrefix?: (url: URL) => Iterable<URL>, probeModule?: (url: URL) => boolean | undefined, resolveModule?: (url: URL) => URL): Iterable<Dependency>",
        "traverse(entry: URL, opts: TraverseOptions, readModule: (url: URL) => Promise<Buffer | string | null>, listPrefix?: (url: URL) => AsyncIterable<URL>, probeModule?: (url: URL) => Promise<boolean | undefined>, resolveModule?: (url: URL) => Promise<URL>): AsyncIterable<Dependency>"
      ],
      "description": "Traverse the module graph rooted at `entry`, which must be a WHATWG `URL` instance. `readModule` is called with a `URL` instance for every module to be read and must either return the module source, if it exists, or `null`. `listPrefix` is called with a `URL` instance of every prefix to be listed and must yield `URL` instances that have the specified `URL` as a prefix. If not provided, prefixes won't be traversed. If `readModule` returns a promise or `listPrefix` returns a promise generator, synchronous iteration is not supported.",
      "deprecated": null,
      "params": [
        {
          "name": "entry",
          "type": "URL",
          "optional": false,
          "default": null,
          "description": "The WHATWG `URL` of the entry module to root the graph at."
        },
        {
          "name": "readModule",
          "type": "(url: URL) => Buffer | string | null",
          "optional": false,
          "default": null,
          "description": "Called with the `URL` of each module to read; returns its source as a `Buffer` or `string`, or `null` if it does not exist. Returning a promise disables synchronous iteration."
        },
        {
          "name": "listPrefix",
          "type": "(url: URL) => Iterable<URL>",
          "optional": true,
          "default": null,
          "description": "Called with the `URL` of each prefix to list; must yield the `URL`s that have it as a prefix. If omitted, prefixes are not traversed."
        },
        {
          "name": "probeModule",
          "type": "(url: URL) => boolean | undefined",
          "optional": true,
          "default": null,
          "description": "Called with the `URL` of each module to probe for existence; returns a boolean, or `undefined` to fall back to `readModule`."
        },
        {
          "name": "resolveModule",
          "type": "(url: URL) => URL",
          "optional": true,
          "default": null,
          "description": "Called with each resolution `URL` to transform; returns the `URL` to use in its place. Defaults to the identity function."
        }
      ],
      "returns": {
        "type": "Iterable<Dependency>",
        "description": "An iterable of resolved `Dependency` records for the module graph; asynchronous when any callback returns a promise."
      },
      "throws": [],
