{
  "name": "hello-pear-qvac",
  "version": "0.0.0-rc.0",
  "description": "Pear Runtime CLI boilerplate: Bare + QVAC on-device inference + a bare-tui interface, with OTA updates.",
  "private": true,
  "bin": "bin.mjs",
  "upgrade": "pear://<YOUR_KEY_HERE>",
  "scripts": {
    "format": "prettier . --write",
    "test": "brittle-bare test/index.js",
    "lint": "prettier . --check && lunte",
    "start": "bare bin.mjs --no-updates",
    "make": "node scripts/make.js",
    "make:darwin-arm64": "bare-build --name hello-pear-qvac --standalone --host darwin-arm64 --out ./out/darwin-arm64 bin.mjs",
    "make:darwin-x64": "bare-build --name hello-pear-qvac --standalone --host darwin-x64 --out ./out/darwin-x64 bin.mjs",
    "make:linux-arm64": "bare-build --name hello-pear-qvac --standalone --host linux-arm64 --out ./out/linux-arm64 bin.mjs",
    "make:linux-x64": "bare-build --name hello-pear-qvac --standalone --host linux-x64 --out ./out/linux-x64 bin.mjs",
    "make:win32-arm64": "bare-build --name hello-pear-qvac --standalone --host win32-arm64 --out ./out/win32-arm64 bin.mjs",
    "make:win32-x64": "bare-build --name hello-pear-qvac --standalone --host win32-x64 --out ./out/win32-x64 bin.mjs"
  },
  "dependencies": {
    "@qvac/inference": "^0.18.2",
    "@qvac/langdetect-text": "^0.1.2",
    "@qvac/llm-llamacpp": "^0.45.0",
    "bare-os": "^3.9.0",
    "bare-path": "^3.0.0",
    "bare-process": "^4.5.0",
    "bare-storage": "^1.1.0",
    "bare-tui": "^0.0.3",
    "bare-tui-updater": "^0.0.1",
    "framed-stream": "^1.0.1",
    "hello-pear-worker": "^1.0.0",
    "paparam": "^1.10.1",
    "pear-runtime": "^1.2.0",
    "ready-resource": "^1.2.0",
    "which-runtime": "^1.4.0"
  },
  "devDependencies": {
    "bare-build": "^1.0.2",
    "bare-runtime": "1.29.4",
    "brittle": "^3.19.0",
    "lunte": "^1.2.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/holepunchto/hello-pear-qvac.git"
  },
  "author": "Holepunch Inc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/hello-pear-qvac/issues"
  },
  "qvac": {
    "model": "LLAMA_3_2_1B_INST_Q4_0",
    "ctxSize": 8192
  }
}
