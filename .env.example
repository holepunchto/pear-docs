# Copy to `.env` (or `.env.local` for Next.js auto-load) and fill in your values.
# `.env` and `.env*.local` are gitignored.

# -----------------------------------------------------------------------------
# Required to install @tetherto/* packages from GitHub Packages.
#
# `.npmrc` reads this as ${GITHUB_TOKEN} at install time. Export it in your
# shell before running `npm install`, source the .env, or use a tool like
# `direnv` / `dotenv-cli`. Same setup used across the org (e.g. qvac's
# .github/actions/run-lint-and-unit-tests action), where CI passes
# secrets.GITHUB_TOKEN (or a PAT) into npmrc.
#
# Generate a classic GitHub PAT with at least `read:packages` scope:
#   https://github.com/settings/tokens
# -----------------------------------------------------------------------------
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# Required for production — SEO (canonical URLs, Open Graph / Twitter absolutes)
# Optional locally: defaults to http://localhost:8080 in src/lib/seo-config.ts
# (matches `npm run serve` static preview). Drives @tetherto/docs-seo-*
# (metadata, sitemap, robots, JSON-LD).
#
# `NEXT_PUBLIC_DOCS_ORIGIN` is preferred. `NEXT_PUBLIC_SITE_URL` is accepted
# as a fallback for environments that already set the more generic name.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DOCS_ORIGIN=https://docs.pears.com
# NEXT_PUBLIC_SITE_URL=https://docs.pears.com

# -----------------------------------------------------------------------------
# Optional — SEO (@tetherto/docs-seo-*)
# -----------------------------------------------------------------------------
# Absolute HTTPS logo for JSON-LD `Organization` publisher.
# NEXT_PUBLIC_DOCS_PUBLISHER_LOGO_URL=https://your-cdn.example/logo.png

# Skip Takumi OG prebuild; metadata uses staticOgImagePath / public/og-default.png.
# SKIP_OG_BUILD=1

# Prebuild only (tsx scripts/generate-og.tsx — not loaded from .env.local
# unless exported into the shell or set in CI).
# DOCS_OG_SITE_LABEL=Pear
# DOCS_OG_CONCURRENCY=3

# Set in `npm run build` / `dev` already. Silences only the [@tetherto/docs-seo]
# warnings for fields with sensible auto-generated / inferred defaults
# (ogImage from Takumi prebuild, schemaType inferred from docType, lastModified
# injected by fumadocs-mdx). Keeps `description` and `docType` warnings live.
# DOCS_SEO_QUIET_GENERATED=1

# Heavy hammer: silence ALL [@tetherto/docs-seo] warnings, including the
# required-`description` warning. Use sparingly.
# DOCS_SEO_SILENT=1

# -----------------------------------------------------------------------------
# QVAC docs search service (src/components/search.tsx) — powers top search.
# Defaults to https://mcp.pears.com. If unreachable or refusing, search falls
# back to the static Orama index (/api/search.json). No token: the service must
# run with QVAC_SEARCH_PUBLIC=1, which opens /api/search (and only it) to
# browsers. A token here would be bundled into the public build.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_QVAC_API_URL=https://mcp.pears.com

# -----------------------------------------------------------------------------
# Required — Inkeep "Ask AI" chat (src/components/search.tsx)
# Client-side key, bundled into the browser build. Search itself is QVAC.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_INKEEP_API_KEY=

# -----------------------------------------------------------------------------
# Optional — docs MCP server (src/components/mcp-install.tsx)
#
# Streamable-HTTP endpoint for the semantic-search MCP server. Drives the
# "Add to your AI tool" button under the sidebar search, which hands out
# install commands and deeplinks for Claude Code and Cursor/VS Code, plus the
# URL to add under Settings → Connectors in Claude Desktop. Leave unset and the
# button does not render at all, so a deploy without an endpoint never ships a
# dead install link.
#
# The installed config carries no credential, so the service must serve /mcp
# without a token: run it with QVAC_MCP_PUBLIC=1 (opens /mcp only, keeps the
# rate limit, drops the ask_docs tool), plus whichever of QVAC_TRUST_CF or
# QVAC_TRUST_XFF matches the host's proxy — the service README's Sevalla
# checklist says how to tell after the first deploy.
# Point this at a stable hostname — a preview URL will churn and every install
# already handed out breaks with it. Include the /mcp path. NEXT_PUBLIC_* is
# inlined at build time, so the site has to be rebuilt after setting it.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_MCP_URL=https://<your-search-service>/mcp
