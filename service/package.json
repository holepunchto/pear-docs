{
  "name": "pear-docs-search-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Semantic search + MCP service for the Pear docs (Next.js, CPU-only, no LLM)",
  "scripts": {
    "fetch:model": "node --import tsx scripts/fetch-model.ts",
    "build:index": "node --import tsx scripts/build-index.ts",
    "dev": "next dev -p 8787",
    "prebuild": "npm run fetch:model",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "mcp-handler": "^2.1.1",
    "next": "^16.3.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "github-slugger": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
