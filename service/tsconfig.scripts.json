{
  // Build-time scripts only. Separate from tsconfig.json because lib/corpus.ts
  // imports `../../scripts/helpers.ts` from the docs tooling — deliberately
  // reaching outside this directory, so that the search index and the link
  // checker derive page URLs from the same function.
  //
  // `next build` type-checks whatever tsconfig.json includes, and a Sevalla
  // build whose Build path is `service` cannot see the repo root. Keeping the
  // scripts out of that config is what lets both be true at once.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve"
  },
  "include": ["scripts/**/*.ts", "lib/**/*.ts", "../scripts/helpers.ts"],
  "exclude": ["node_modules", ".next"]
}
