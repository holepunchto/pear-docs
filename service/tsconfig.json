{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  // `scripts/` is excluded because `next build` type-checks whatever this config
  // includes, and scripts/build-index.ts imports ../../src/corpus.ts — a path
  // OUTSIDE this directory, and therefore outside the Docker build context. Left
  // in, the image build dies at "Cannot find module '../../src/corpus.ts'" even
  // though that file never ships. tsconfig.scripts.json checks the scripts on a
  // dev machine or in CI, where the sibling checkout does exist; `npm run
  // typecheck` runs both.
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "scripts"
  ]
}
