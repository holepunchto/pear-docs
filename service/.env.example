# ---------------------------------------------------------------------------
# Everything here is optional. With no env at all the service runs open on
# :8787 with a 60 req/min shared rate limit — fine locally, not for production.
# ---------------------------------------------------------------------------

# Port. Sevalla injects this; leave unset there.
PORT=8787

# --- Encoder ---------------------------------------------------------------
# Must MATCH the model the committed index was built with, or startup fails
# loudly (engine.ts checks model id, dim, pooling and query prefix).
# One of: bge-small (default) | gte-small | minilm
EMBED_MODEL=bge-small
# ONNX weight precision: q8 (default, fastest on CPU) | fp32 | fp16
EMBED_DTYPE=q8
# Chunks per forward pass during `npm run build:index`. Runtime queries are
# always batch-of-one, so this only affects build speed/memory.
EMBED_BATCH=16
# ONNX intra-op threads. Default 1 at runtime — onnxruntime otherwise sizes its
# pool from the HOST core count, which on a 0.5-vCPU pod means a dozen threads
# fighting over half a core. `npm run build:index` raises it on its own.
ORT_THREADS=1
# Where the vendored ONNX weights live. Defaults to <cwd>/models, which is right
# under every builder; set it only if you mount the weights elsewhere.
MODELS_DIR=

# --- Branding ---------------------------------------------------------------
MCP_SERVER_NAME=pear-docs
DOCS_LABEL=Pear
# Set to the docs origin so MCP tool output cites absolute URLs an agent can
# actually open. Leave unset to emit the relative paths stored in the index.
DOCS_SITE_URL=https://docs.pears.com

# --- Access control ---------------------------------------------------------
# Bearer token for /api/* and /mcp. /api/health stays open (liveness only).
# NOTE: a token shipped to a public static site via NEXT_PUBLIC_* is visible in
# the browser bundle — it deters bots and lets you rotate access; it is not a
# secret. Pair with ALLOWED_ORIGINS.
API_TOKEN=

# Comma-separated CORS origin allowlist. Unset = `*`, which is what makes the
# docs site's browser search work out of the box. Set it to the docs origin(s).
ALLOWED_ORIGINS=https://docs.pears.com

# Comma-separated IP allowlist; a trailing `*` matches a prefix
# (e.g. 2802:8011:3070:6300:*). Requires a trusted IP source below — with none,
# the allowlist DENIES everything rather than silently passing.
ALLOWED_IPS=

# --- Client IP resolution ---------------------------------------------------
# A Web Request exposes no socket, so without one of these there is no client
# identity and every caller shares ONE rate-limit bucket.
# Number of trusted reverse proxies appending to X-Forwarded-For. On Sevalla: 1.
TRUST_PROXY_HOPS=1
# Set to 1 only if a Cloudflare edge is genuinely in front (it rewrites
# CF-Connecting-IP, so a client cannot forge it).
TRUST_CF=0

# --- Limits -----------------------------------------------------------------
# Requests per window, per client. 0 disables. In-memory, so PER INSTANCE.
RATE_MAX=60
RATE_WINDOW_S=60
# Applies to /api/search only; mcp-handler owns the /mcp body.
MAX_BODY_BYTES=262144

# --- Index build (build machine / CI only) ----------------------------------
# Defaults to the repo root, one level up from service/. Only set this to index
# a different checkout.
DOCS_ROOT=
