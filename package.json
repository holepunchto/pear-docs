{
  "name": "pearpass-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "DOCS_SEO_QUIET_GENERATED=1 tsx scripts/generate-og.tsx",
    "build": "DOCS_SEO_QUIET_GENERATED=1 next build",
    "postbuild": "tsx scripts/generate-redirect-stubs.ts",
    "build:og": "DOCS_SEO_QUIET_GENERATED=1 tsx scripts/generate-og.tsx",
    "dev": "DOCS_SEO_QUIET_GENERATED=1 next dev",
    "start": "next start",
    "serve": "serve out -p 8080",
    "types:check": "tsx node_modules/fumadocs-mdx/dist/bin.js && next typegen && tsc --noEmit",
    "postinstall": "tsx node_modules/fumadocs-mdx/dist/bin.js",
    "lint": "eslint",
    "audit:reference-docs": "tsx scripts/audit-reference-docs.ts",
    "add-api-github-links": "tsx scripts/add-api-github-links.ts --write",
    "check:internal-links": "npx tsx scripts/check-internal-links.ts",
    "check:external-links": "npx tsx scripts/check-external-links.ts",
    "check:cross-links": "npx tsx scripts/check-cross-links.ts",
    "check:redirects": "npx tsx scripts/check-redirects.ts",
    "check:doctypes": "npx tsx scripts/check-doctypes.ts"
  },
  "dependencies": {
    "@takumi-rs/image-response": "^1.0.0-rc.14",
    "@tetherto/docs-seo-core": "^1.0.1",
    "@tetherto/docs-seo-next": "^1.0.1",
    "@tetherto/docs-seo-og": "^1.1.1",
    "@tetherto/docs-seo-schema": "^1.1.0",
    "beautiful-mermaid": "^1.1.3",
    "fumadocs-core": "16.5.4",
    "fumadocs-mdx": "14.2.7",
    "fumadocs-ui": "16.5.4",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-medium-image-zoom": "^5.4.5",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@fontsource/poppins": "^5.2.7",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.6",
    "postcss": "^8.5.6",
    "serve": "^14.2.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
